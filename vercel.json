{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "backend": {
      "framework": "fastapi",
      "port": 8000,
      "workflow": "build-and-start",
      "runtime": "python@3.12"
    }
  },
  "routes": [
    { "src": "/health", "dest": "/api/v1/health" },
    { "src": "/api/(.*)", "dest": "/backend/$1" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}